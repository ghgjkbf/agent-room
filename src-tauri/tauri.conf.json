{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Room",
  "version": "0.1.0",
  "identifier": "com.agentroom.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:8899",
    "beforeDevCommand": "npm run dev:backend"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Room · 多Agent群聊协作",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
